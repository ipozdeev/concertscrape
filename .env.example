# Copy to .env and fill in. Only YOUTUBE_API_KEY is required for the .ics feed.

# --- Required: YouTube Data API v3 key (read-only, no OAuth) ---
# Create at https://console.cloud.google.com/ -> APIs & Services -> Credentials.
YOUTUBE_API_KEY=

# --- Optional: output directory for calendar.ics (default: docs) ---
# OUTPUT_DIR=docs

# --- Optional: mirror events into a Google Calendar (needs the 'gcal' extra) ---
# Requires OAuth client secrets; run once interactively to create token-calendar.json.
# CALENDAR_ID=your_calendar_id@group.calendar.google.com
# GOOGLE_CREDS_FILE=/path/to/client_secret.json

# --- Optional: email a log digest (not wired by default) ---
# LOG_EMAIL_TO=you@example.com
# LOG_EMAIL_FROM=bot@example.com
